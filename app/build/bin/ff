#!/bin/sh
fastforward_appimage=
terminal=
[ "$1" = --term ] && terminal=--term && shift
[ $# -eq 0 ] && set -- "$PWD"
for folder do
  case $folder in
    /* | [A-Za-z]:*) ;;
    *) folder=$PWD/$folder ;;
  esac
  set -- "$@" "$folder"
  shift
done
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case $link in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
here=$(cd "$(dirname "$script")" && pwd -P)
case $(uname) in
  Darwin)
    app=$(cd "$here/../../.." && pwd -P)
    [ -n "$terminal" ] && exec "$app/Contents/MacOS/Fastforward" --term -- "$@"
    exec open -n -a "$app" --args -- "$@"
    ;;
  MINGW* | MSYS*)
    [ -n "$terminal" ] && exec "$here/../Fastforward.exe" --term -- "$@"
    "$here/../Fastforward.exe" -- "$@" </dev/null >/dev/null 2>&1 &
    ;;
  *)
    launcher=${fastforward_appimage:-/opt/Fastforward/fastforward}
    [ -n "$terminal" ] && exec "$launcher" --term -- "$@"
    nohup "$launcher" -- "$@" </dev/null >/dev/null 2>&1 &
    ;;
esac
