{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "unicorn/require-post-message-target-origin": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/incompatible-library": "off",
    "react/set-state-in-effect": "off"
  },
  "overrides": [
    {
      "files": ["src/webview/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The webview runs sandboxed, without Electron"
              }
            ],
            "patterns": [
              {
                "group": ["../*", "!../shared/*"],
                "message": "The webview imports only its own code and shared/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "shared/ runs in the webview too"
              }
            ],
            "patterns": [
              {
                "group": ["../*", "node:*"],
                "message": "shared/ runs in both, so it imports only shared/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/*.ts", "src/git/**", "src/history/**", "src/main/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/webview/*", "./webview/*"],
                "message": "The main process doesn't import the webview's code"
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "out", "release"]
}
