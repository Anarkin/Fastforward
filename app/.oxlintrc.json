{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "unicorn/require-post-message-target-origin": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/incompatible-library": "off",
    "react/set-state-in-effect": "off",
    "max-lines": [
      "warn",
      {
        "max": 1000
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/page/**", "src/shell/page/**", "src/tools/*/page/**"],
      "rules": {
        "react/jsx-no-literals": [
          "error",
          {
            "noStrings": true,
            "ignoreProps": true,
            "restrictedAttributes": ["title", "placeholder", "aria-label"]
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The webview runs sandboxed, without Electron"
              }
            ],
            "patterns": [
              {
                "group": ["**/main/**", "**/main"],
                "message": "The page imports only page and shared code, as it runs sandboxed"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/shared/**",
        "src/shell/shared/**",
        "src/tools/*/shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "shared/ runs in the webview too"
              }
            ],
            "patterns": [
              {
                "group": ["**/main/**", "**/page/**", "node:*", "node:*/**"],
                "message": "shared/ runs in both, so it imports only shared/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/boot/**",
        "src/lib/main/**",
        "src/shell/main/**",
        "src/tools/*/main/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/page/**"],
                "message": "The main process doesn't import the page's code"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/test/**"],
      "rules": {
        "no-underscore-dangle": [
          "error",
          {
            "allow": ["_willUpdate"]
          }
        ]
      }
    },
    {
      "files": ["src/lib/shared/strings.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["src/test/src/tools/git/page/syntax.test.ts"],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 2400
          }
        ]
      }
    },
    {
      "files": ["src/test/src/tools/commander/main/tool.test.ts"],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 2000
          }
        ]
      }
    },
    {
      "files": [
        "src/test/src/tools/commander/page/store.test.ts",
        "src/test/src/tools/git/page/commitList.test.tsx"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 1800
          }
        ]
      }
    },
    {
      "files": [
        "src/tools/commander/page/store.ts",
        "src/tools/git/main/tool.ts"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 1700
          }
        ]
      }
    },
    {
      "files": [
        "scripts/playground/filesPlan.mts",
        "scripts/playground/git.mts",
        "src/test/src/tools/git/main/tool/oneRepository.git.test.ts"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 1600
          }
        ]
      }
    },
    {
      "files": [
        "src/shell/main/shell.ts",
        "src/test/src/tools/git/main/cli/workingTree.git.test.ts",
        "src/tools/commander/main/tool.ts"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 1500
          }
        ]
      }
    },
    {
      "files": [
        "src/boot/main.ts",
        "src/test/e2e/appLaunches.electron.test.ts",
        "src/test/src/shell/main/shell.test.ts",
        "src/test/src/tools/git/main/tool/diffs.git.test.ts",
        "src/test/src/tools/git/main/tool/refreshing.git.test.ts",
        "src/tools/commander/page/pane.tsx",
        "src/tools/git/page/diffView.tsx"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 1400
          }
        ]
      }
    },
    {
      "files": [
        "src/test/src/tools/commander/main/archiveCopies.test.ts",
        "src/test/src/tools/commander/main/archiveRoundTrips.7zip.test.ts",
        "src/test/src/tools/git/main/tool/otherRepositories.git.test.ts",
        "src/test/src/tools/git/page/locations.test.tsx",
        "src/tools/git/page/commitList.tsx"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 1300
          }
        ]
      }
    },
    {
      "files": [
        "src/shell/page/tabBar.tsx",
        "src/test/e2e/appEditor.electron.test.ts",
        "src/test/e2e/appWrapping.electron.test.ts",
        "src/test/src/tools/commander/page/view.test.ts",
        "src/test/src/tools/git/main/cli/watch.test.ts",
        "src/test/src/tools/git/page/store.test.ts",
        "src/tools/commander/main/archives.ts",
        "src/tools/commander/page/editor.tsx",
        "src/tools/git/main/cli/watch.ts",
        "src/tools/git/page/locations.tsx",
        "src/lib/page/syntaxEngine.ts"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 1200
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "release", "perf-results", "perf-build"]
}
