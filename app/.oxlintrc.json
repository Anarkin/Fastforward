{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "unicorn/require-post-message-target-origin": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/incompatible-library": "off",
    "react/set-state-in-effect": "off"
  },
  "overrides": [
    {
      "files": ["src/shell/page/**", "src/tools/*/page/**", "src/ui/**"],
      "rules": {
        "react/jsx-no-literals": [
          "error",
          {
            "noStrings": true,
            "ignoreProps": true,
            "restrictedAttributes": ["title", "placeholder", "aria-label"]
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The webview runs sandboxed, without Electron"
              }
            ],
            "patterns": [
              {
                "group": ["**/main/**", "**/main"],
                "message": "The page imports only page, ui and shared code, as it runs sandboxed"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/**",
        "src/shell/shared/**",
        "src/tools/*/shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "shared/ runs in the webview too"
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/main/**",
                  "**/page/**",
                  "**/ui/**",
                  "node:*",
                  "node:*/**"
                ],
                "message": "shared/ runs in both, so it imports only shared/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main/**", "src/shell/main/**", "src/tools/*/main/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/page/**", "**/ui/**"],
                "message": "The main process doesn't import the page's code"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/test/**"],
      "rules": {
        "no-underscore-dangle": [
          "error",
          {
            "allow": ["_willUpdate"]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "release"]
}
