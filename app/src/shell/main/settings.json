{
  "autoSortTabs": false,
  "tools": {
    "git": {
      "collapseMerges": true,
      "showAllFiles": false,
      "entireFilePinned": true,
      "ignoreWhitespace": true,
      "wordWrap": true,
      "showWhitespace": false,
      "diffLayout": "sideBySide",
      "solo": false,
      "autoFetch": true,
      "autoFetchMinutes": 1,
      "hideDimmedButtons": true,
      "columnWidths": [300, 250]
    },
    "files": {},
    "terminal": {
      "shell": "",
      "shellArgs": [],
      "renderer": "webgl"
    }
  },
  "fonts": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "size": "12px",
    "monospaceFamily": "'JetBrains Mono NL', 'JetBrains Mono', ui-monospace, Menlo, Monaco, Consolas, 'Droid Sans Mono', 'Courier New', monospace",
    "monospaceSize": "12px",
    "monospaceLineHeight": 1.4
  },
  "sizes": {
    "scrollbar": "20px",
    "minimap": "40px"
  },
  "colors": {
    "light": {
      "foreground": "#000",
      "foreground-muted": "45%",
