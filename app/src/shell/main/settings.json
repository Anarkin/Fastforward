    "git": {
      "collapseMerges": true,
      "showAllFiles": false,
      "showEntireFile": true,
      "ignoreWhitespace": true,
      "diffLayout": "sideBySide",
      "solo": false,
      "autoFetch": true,
      "autoFetchMinutes": 1,
      "hideDimmedButtons": true,
      "keepGitRunning": true,
      "columnWidths": [300, 250],
      "colors": {
        "light": {
          "icon": "#c63d1d",

          "bubble": "#ddd",
          "bubble-foreground": "#000",
          "bubble-border": "#ffffff00",
