{
  "autoSortTabs": false,
  "recentItems": 15,
  "dateFormat": "YYYY-MM-DD HH:mm",
  "fonts": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "size": "12px",
    "monospaceFamily": "'JetBrains Mono NL', 'JetBrains Mono', ui-monospace, Menlo, Monaco, Consolas, 'Droid Sans Mono', 'Courier New', monospace",
    "monospaceSize": "12px",
    "monospaceLineHeight": 1.4
  },
  "sizes": {
    "scrollbar": "20px",
    "minimap": "40px"
  },
  "tools": {
    "terminal": {
      "shell": "",
      "shellArgs": [],
      "renderer": "webgl",
      "scrollback": 10000,
      "minimumContrastRatio": 4.5,
      "colors": {
        "light": {
          "icon": "#000",

          "background": "#fff",
          "foreground": "#000000",
          "selection": "#0066cc2e",
          "black": "#000000",
          "red": "#a00000",
          "green": "#00a000",
          "yellow": "#a0a000",
          "blue": "#0000a0",
          "magenta": "#a000a0",
          "cyan": "#00a0a0",
          "white": "#a0a0a0",
          "bright-black": "#a0a0a0",
          "bright-red": "#c00000",
          "bright-green": "#00c000",
          "bright-yellow": "#c0c000",
          "bright-blue": "#0000c0",
          "bright-magenta": "#c000c0",
          "bright-cyan": "#00c0c0",
          "bright-white": "#a0a0a0"
        },
        "dark": {
          "icon": "#ddd",

          "background": "#111",
          "foreground": "#c0c0c0",
          "selection": "#0066cc59",
          "black": "#000000",
          "red": "#800000",
          "green": "#008000",
          "yellow": "#808000",
          "blue": "#000080",
          "magenta": "#800080",
          "cyan": "#008080",
          "white": "#c0c0c0",
          "bright-black": "#808080",
          "bright-red": "#ff0000",
          "bright-green": "#00ff00",
          "bright-yellow": "#ffff00",
          "bright-blue": "#0000ff",
          "bright-magenta": "#ff00ff",
          "bright-cyan": "#00ffff",
          "bright-white": "#ffffff"
        }
      }
    },
    "commander": {
      "showHidden": true,
      "sort": {
        "left": { "column": "extension", "descending": false },
        "right": { "column": "extension", "descending": false }
      },
      "columns": { "extension": 10, "size": 15, "date": 16 },
      "colors": {
        "light": {
          "icon": "#1a5fb4"
        },
        "dark": {
          "icon": "#5294e2"
        }
      }
    },
    "git": {
      "collapseMerges": true,
      "showAllFiles": false,
      "entireFilePinned": true,
      "ignoreWhitespace": true,
      "wordWrap": true,
      "showWhitespace": false,
      "diffLayout": "sideBySide",
      "solo": false,
      "autoFetch": true,
      "autoFetchMinutes": 1,
      "hideDimmedButtons": true,
      "columnWidths": [300, 250],
      "colors": {
        "light": {
          "icon": "#c63d1d",

          "bubble": "#ddd",
          "bubble-foreground": "#000",
          "bubble-border": "#ffffff00",
          "bubble-checked-out": "#06c",
          "bubble-checked-out-foreground": "#fff",
          "bubble-checked-out-border": "#ffffff00",

          "graph-blue": "#15f",
          "graph-green": "#383",
          "graph-orange": "#c81",
          "graph-purple": "#638",
          "graph-red": "#a00",
          "graph-yellow": "#670",
          "graph-cyan": "#09b",
          "graph-magenta": "#b0b"
        },
        "dark": {
          "icon": "#f05032",

          "bubble": "#444",
          "bubble-foreground": "#ddd",
          "bubble-border": "#ffffff00",
          "bubble-checked-out": "#06c",
          "bubble-checked-out-foreground": "#fff",
          "bubble-checked-out-border": "#ffffff00",

          "graph-blue": "#5af",
          "graph-green": "#8c8",
          "graph-orange": "#c82",
          "graph-purple": "#a8d",
          "graph-red": "#e87",
          "graph-yellow": "#eb7",
          "graph-cyan": "#1ac",
          "graph-magenta": "#b4b"
        }
      }
    }
  },
  "colors": {
    "light": {
      "foreground": "#000",
      "foreground-muted": "45%",
      "error-foreground": "#f00",
      "warning-foreground": "#e90",

      "background": "#ccc",
      "panel-background": "#fff",
      "notice-background": "#ffd",

      "border": "#ccc",

      "focus": "#06c",
      "focus-foreground": "#fff",
      "focus-hover": "8%",
      "focus-selected": "18%",

      "search-match": "#fe6",
      "search-match-foreground": "#000",

      "scrollbar": "#666",
      "scrollbar-rest": "75%",
      "scrollbar-hover": "82%",
      "scrollbar-drag": "88%",

      "change-added": "#0a0",
      "change-added-line": "20%",
      "change-added-row": "8%",
      "change-added-minimap": "50%",
      "change-deleted": "#a00",
      "change-deleted-line": "20%",
      "change-deleted-row": "8%",
      "change-deleted-minimap": "50%",
      "change-modified": "#a70",
      "change-renamed": "#06c",

      "syntax-keyword": "#00d",
      "syntax-type": "#088",
      "syntax-function": "#a0a",
      "syntax-string": "#d00",
      "syntax-number": "#d00",
      "syntax-comment": "#080"
    },
    "dark": {
      "foreground": "#ddd",
      "foreground-muted": "45%",
      "error-foreground": "#f44",
      "warning-foreground": "#fb0",

      "background": "#2a2a2a",
      "panel-background": "#111",
      "notice-background": "#3d3a26",

      "border": "#2a2a2a",

      "focus": "#06c",
      "focus-foreground": "#fff",
      "focus-hover": "20%",
      "focus-selected": "35%",

      "search-match": "#fc0",
      "search-match-foreground": "#000",

      "scrollbar": "#999",
      "scrollbar-rest": "75%",
      "scrollbar-hover": "82%",
      "scrollbar-drag": "88%",

      "change-added": "#0c0",
      "change-added-line": "20%",
      "change-added-row": "8%",
      "change-added-minimap": "50%",
      "change-deleted": "#e00",
      "change-deleted-line": "20%",
      "change-deleted-row": "8%",
      "change-deleted-minimap": "50%",
      "change-modified": "#d92",
      "change-renamed": "#5af",

      "syntax-keyword": "#59c",
      "syntax-type": "#088",
      "syntax-function": "#da7",
      "syntax-string": "#e75",
      "syntax-number": "#e75",
      "syntax-comment": "#5a5"
    }
  }
}
