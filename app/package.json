{
  "name": "fastforward",
  "productName": "Fastforward",
  "description": "A desktop app for git",
  "version": "6.0.0",
  "author": {
    "name": "Adam Lengyel",
    "email": "lengyel.adam@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Anarkin/Fastforward.git"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --dev",
    "start": "npm run build && electron .",
    "package": "npm run check-types && node esbuild.mjs --production",
    "check-types": "tsc --noEmit && tsc -p tsconfig.main.json && tsc -p tsconfig.webview.json",
    "compile-tests": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p .",
    "pretest": "npm run build && npm run compile-tests",
    "test": "mocha --ui tdd --forbid-only --require out/test/rootHooks.js --parallel --jobs 6 \"out/test/**/*.test.js\"",
    "test:unit": "mocha --ui tdd --forbid-only --require out/test/rootHooks.js --parallel --jobs 6 \"out/test/**/*.test.js\" --exclude \"out/test/**/*.git.test.js\" --exclude \"out/test/**/*.electron.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "npm run pretest && node -e \"require('fs').rmSync('coverage', { recursive: true, force: true })\" && c8 --exclude-after-remap --exclude \"src/test/**\" --reporter text --reporter html mocha --ui tdd --require out/test/rootHooks.js --parallel --jobs 6 \"out/test/**/*.test.js\"",
    "verify": "npm run format:check && npm run lint && npm run knip && tsc -p tsconfig.main.json && tsc -p tsconfig.webview.json && npm test",
    "verify:fast": "npm run format:check && npm run lint && npm run knip && tsc -p tsconfig.main.json && tsc -p tsconfig.webview.json && npm run compile-tests && npm run test:unit",
    "lint": "oxlint --type-aware --deny-warnings",
    "knip": "knip",
    "dist": "npm run package && electron-builder --publish never",
    "release": "node release.mjs",
    "portable": "npm run package && electron-builder --publish never -c.win.target=portable -c.mac.target=zip -c.linux.target=AppImage"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^12.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "knip": "^6.38.0",
    "mocha": "^11.8.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://github.com/Anarkin/Fastforward",
  "build": {
    "appId": "io.github.anarkin.fastforward",
    "productName": "Fastforward",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "Anarkin",
      "repo": "Fastforward"
    }
  }
}
