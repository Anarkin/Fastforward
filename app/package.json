{
  "name": "fastforward",
  "productName": "Fastforward",
  "description": "A collection of desktop tools",
  "version": "22.0.0",
  "author": {
    "name": "Adam Lengyel",
    "email": "lengyel.adam@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Anarkin/Fastforward.git"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "node scripts/esbuild.mts",
    "dev": "node scripts/esbuild.mts --dev",
    "dev:open": "electron . --",
    "package": "npm run check-types && node scripts/esbuild.mts --production",
    "check-types": "tsc --noEmit && tsc -p tsconfig.main.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.scripts.json",
    "pretest": "npm run build",
    "test": "vitest run --project=!playground",
    "test:unit": "vitest run --project unit",
    "test:playground": "vitest run --project playground",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "npm run build && vitest run --coverage --project=!playground",
    "verify": "npm run format:check && npm run lint && npm run knip && npm run check-types && npm test",
    "verify:fast": "npm run format:check && npm run lint && npm run knip && npm run check-types && npm run test:unit",
    "lint": "oxlint --type-aware --deny-warnings",
    "knip": "knip",
    "dist": "npm run package && electron-builder --publish never",
    "release": "node scripts/release.mts",
    "playground:git": "node scripts/playground/git.mts"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.15",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^44.10.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.2.0-beta.18"
  },
  "homepage": "https://github.com/Anarkin/Fastforward",
  "build": {
    "appId": "io.github.anarkin.fastforward",
    "productName": "Fastforward",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/node-pty/{src,third_party,scripts,typings}/**",
      "!node_modules/node-pty/binding.gyp",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-addon-api/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "artifactName": "fastforward-${version}-macos-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "build/bin/ff",
          "to": "bin/ff"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "artifactName": "fastforward-${version}-windows-x64.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraFiles": [
        {
          "from": "build/bin",
          "to": "bin",
          "filter": [
            "ff",
            "ff.cmd"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "fastforward-${version}-windows-x64-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "artifactName": "fastforward-${version}-linux-x64.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "extraResources": [
        {
          "from": "build/bin/ff",
          "to": "bin/ff"
        }
      ]
    },
    "deb": {
      "fpm": [
        "build/bin/ff=/usr/bin/ff"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Anarkin",
      "repo": "Fastforward"
    }
  }
}
