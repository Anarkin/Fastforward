{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/app",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/app/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
