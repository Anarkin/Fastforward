{
  "name": "fastforward",
  "displayName": "Fastforward",
  "description": "Git workflows for VS Code",
  "version": "0.0.1",
  "publisher": "anarkin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anarkin/Fastforward.git"
  },
  "engines": {
    "vscode": "^1.130.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fastforward.toggleView",
        "title": "Toggle View",
        "category": "Fastforward",
        "icon": "$(run-all)"
      }
    ],
    "keybindings": [
      {
        "command": "fastforward.toggleView",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "customEditors": [
      {
        "viewType": "fastforward.view",
        "displayName": "Fastforward",
        "selector": [
          {
            "filenamePattern": "view"
          }
        ],
        "priority": "option"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "fastforward",
        "formatting": {
          "label": "${authority}",
          "separator": "/"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check-types && node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run build && npm run compile-tests",
    "test": "vscode-test --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "copy-root-files": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../' + f, f)\"",
    "vsce:package": "npm run copy-root-files && vsce package",
    "vsce:publish": "npm run copy-root-files && vsce publish",
    "deploy-local": "npm run package && node deploy-local.mjs",
    "install-local": "npm run vsce:package -- --out fastforward.vsix && code --install-extension fastforward.vsix --force",
    "verify": "npm run format:check && npm run lint && npm run check-types && npm test",
    "lint": "oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
